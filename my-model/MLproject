name: my-model

entry_points:
  train:
    parameters:
      train_data: {type: string}
      model: {type: string}
    command: "uv run python -m my_model.cli train-cmd {train_data} {model}"

  predict:
    parameters:
      model: {type: string}
      historic_data: {type: string}
      future_data: {type: string}
      out_file: {type: string}
    command: "uv run python -m my_model.cli predict-cmd {model} {historic_data} {future_data} {out_file}"
