"""Model implementation for {{project_name}}."""

from typing import Any

import pandas as pd
from pydantic import BaseModel, Field


class {{project_name_class}}Config(BaseModel):
    """Configuration for {{project_name}}."""

    n_samples: int = Field(default=10, description="Number of prediction samples")


def train(
    config: {{project_name_class}}Config,
    data: pd.DataFrame,
) -> dict[str, float]:
    """Train the model.

    Args:
        config: Model configuration.
        data: Training data with time_period, location, and disease_cases columns.

    Returns:
        Trained model object (must be pickleable).
    """
    # Example: compute mean of disease_cases
    mean_value = data["disease_cases"].mean()
    return {"mean": float(mean_value)}


def predict(
    config: {{project_name_class}}Config,
    model: dict[str, float],
    historic: pd.DataFrame,
    future: pd.DataFrame,
) -> pd.DataFrame:
    """Generate predictions.

    Args:
        config: Model configuration.
        model: Trained model object from train().
        historic: Recent historical data.
        future: Future periods to predict (time_period, location columns).

    Returns:
        DataFrame with time_period, location, and samples columns.
    """
    # Generate samples around the mean
    predictions = future.copy()
    predictions["samples"] = [
        [model["mean"]] * config.n_samples for _ in range(len(future))
    ]

    return predictions
