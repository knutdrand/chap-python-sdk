"""Tests for {{project_name}} model."""

import pandas as pd

from {{project_name_underscore}}.model import {{project_name_class}}Config, predict, train


def test_train_basic() -> None:
    """Test basic training functionality."""
    # Create sample training data
    train_data = pd.DataFrame({
        "time_period": [1, 2, 3, 4, 5],
        "location": ["A", "A", "A", "A", "A"],
        "disease_cases": [10, 15, 12, 18, 20],
    })

    config = {{project_name_class}}Config()
    model = train(config, train_data)

    assert "mean" in model
    assert isinstance(model["mean"], float)


def test_predict_basic() -> None:
    """Test basic prediction functionality."""
    # Create sample data
    historic_data = pd.DataFrame({
        "time_period": [1, 2, 3],
        "location": ["A", "A", "A"],
        "disease_cases": [10, 15, 12],
    })

    future_data = pd.DataFrame({
        "time_period": [4, 5],
        "location": ["A", "A"],
    })

    config = {{project_name_class}}Config(n_samples=5)

    # Train model
    model = train(config, historic_data)

    # Generate predictions
    predictions = predict(config, model, historic_data, future_data)

    # Verify predictions
    assert len(predictions) == len(future_data)
    assert "samples" in predictions.columns
    assert all(len(samples) == 5 for samples in predictions["samples"])


def test_predict_multiple_locations() -> None:
    """Test predictions with multiple locations."""
    # Create sample data with multiple locations
    historic_data = pd.DataFrame({
        "time_period": [1, 1, 2, 2, 3, 3],
        "location": ["A", "B", "A", "B", "A", "B"],
        "disease_cases": [10, 20, 15, 25, 12, 22],
    })

    future_data = pd.DataFrame({
        "time_period": [4, 4, 5, 5],
        "location": ["A", "B", "A", "B"],
    })

    config = {{project_name_class}}Config(n_samples=10)

    # Train and predict
    model = train(config, historic_data)
    predictions = predict(config, model, historic_data, future_data)

    # Verify predictions
    assert len(predictions) == len(future_data)
    assert "time_period" in predictions.columns
    assert "location" in predictions.columns
    assert "samples" in predictions.columns
